# Optional AI chat. Leave CHAT_API_KEY empty to use the blog without chat.
# Local: copy to .env.local. Production: configure server runtime variables/secrets.
# Presets: bailian | volcengine | deepseek | openai | gemini | custom
CHAT_PROVIDER=bailian
CHAT_API_KEY=
# Choose a model enabled for your account (Volcengine also accepts endpoint IDs).
CHAT_MODEL=
# Optional override for any preset; required for custom. HTTPS OpenAI-compatible API.
# Base URL or complete /chat/completions endpoint; never use /responses or Gemini native API.
CHAT_BASE_URL=
# Optional output token budget: 128–8192, default 1500.
CHAT_MAX_TOKENS=1500
# Optional: max_tokens | max_completion_tokens (OpenAI preset uses the latter).
CHAT_TOKEN_PARAMETER=
