---
import Layout from "../layouts/MatrixLayout.astro";
import { siteMeta } from "../matrix/config/site.js";
---
<Layout title="自研项目"><h1>{siteMeta.projectPage.title}。</h1><p>{siteMeta.projectPage.description}</p>{siteMeta.projects.map(project => <article><h2><a href={project.url}>{project.name}</a></h2><p>{project.description}</p></article>)}</Layout>
