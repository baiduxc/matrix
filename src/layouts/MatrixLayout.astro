---
import App from "../matrix/MatrixApp.jsx";
import { MatrixBoot } from "../matrix/MatrixBoot.jsx";
import "../matrix/styles.css";
import "katex/dist/katex.min.css";
import { siteMeta } from "../matrix/config/site.js";
import { postMeta, getArticleHTML } from "../lib/matrix-content";
import type { CollectionEntry } from "astro:content";
interface Props {
	title?: string;
	description?: string;
	post?: CollectionEntry<"posts">;
}
const {
	title = "我的数字世界",
	description = siteMeta.description,
	post,
} = Astro.props;
const initialArticle = post
	? { id: post.slug, html: await getArticleHTML(post) }
	: null;
const canonical = new URL(Astro.url.pathname.replace(/\/?$/, "/"), Astro.site || siteMeta.url).href;
const meta = post ? postMeta(post) : null;
const image = new URL(
	meta?.image || "/assets/matrix/default-cover.svg",
	Astro.site || siteMeta.url,
).href;
const schema = post
	? {
			"@context": "https://schema.org",
			"@type": "BlogPosting",
			headline: post.data.title,
			description,
			datePublished: post.data.published.toISOString(),
			dateModified: meta?.updated,
			author: { "@type": "Person", name: meta?.author },
			image,
			mainEntityOfPage: canonical,
			publisher: { "@type": "Person", name: siteMeta.owner },
		}
	: null;
---
<!doctype html><html lang="zh-CN"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/>
<style is:inline>html,body{margin:0;min-width:320px;background:#000704;color:#e8fff4}.matrix-static-content[hidden]{display:none!important}.matrix-startup{position:fixed;inset:0;z-index:90;display:flex;align-items:center;justify-content:center;flex-direction:column;gap:18px;background:#000704;color:#e8fff4;font-family:system-ui,sans-serif}.matrix-startup>span{font-size:30px;letter-spacing:4px}.matrix-startup>small{font-size:12px;letter-spacing:3px;color:#61ffc0}.matrix-startup>a{color:#61ffc0}</style>
<title>{title} · {siteMeta.title}</title><meta name="description" content={description}/><meta name="theme-color" content="#001109"/>
<link rel="canonical" href={canonical}/><link rel="icon" href={siteMeta.favicon}/><link rel="alternate" type="application/rss+xml" title={siteMeta.title} href="/rss.xml"/>
<meta property="og:type" content={post ? 'article' : 'website'}/><meta property="og:title" content={`${title} · ${siteMeta.title}`}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/><meta property="og:image" content={image}/><meta property="og:site_name" content={siteMeta.title}/>
<meta name="twitter:card" content="summary_large_image"/>
{schema && <script is:inline type="application/ld+json" data-matrix-article-schema set:html={JSON.stringify(schema).replaceAll('<', '\u003c')}/>}
</head><body><App client:only="react" initialArticle={initialArticle}>
<div slot="fallback"><MatrixBoot/><main class="matrix-static-content" hidden><slot/></main><noscript><style is:inline>.matrix-startup{display:none!important}.matrix-static-content[hidden]{display:block!important;max-width:1200px;margin:auto;padding:32px 24px;background:#fff;color:#17201c;font:17px/1.9 system-ui,sans-serif}.matrix-static-content .markdown>*{opacity:1;filter:none;transform:none}.matrix-static-content .markdown,.matrix-static-content .markdown :is(h2,h3,strong){color:#17201c}</style></noscript></div>
</App></body></html>
